# Build output
/build/bin/
/dist/
ja-db
ja-db.exe
/devserver
/devserver.exe

# Wails generated bindings (regenerated by `wails dev` / `wails build`)
/frontend/wailsjs/

# Frontend
/frontend/node_modules/
/frontend/dist/*
# main.go embeds frontend/dist, so the directory must exist in a fresh clone
# or `go build ./...` fails before the frontend has ever been built.
!/frontend/dist/.gitkeep
/frontend/.vite/
*.local

# Local state — MUST NOT be committed, contains credentials
*.db
*.sqlite
*.sqlite3
/scratch/

# Agent worktrees
/.claude/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
